{
  "name": "recording-agent-starter",
  "version": "0.0.0",
  "private": true,
  "description": "A local-first starter that turns Feishu recordings into auditable Markdown records.",
  "type": "module",
  "bin": {
    "recording-agent": "./dist/cli.js"
  },
  "files": [
    "dist",
    "fixtures",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run privacy:scan",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "privacy:scan": "node scripts/privacy-scan.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
